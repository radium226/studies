<?xml version="1.0" encoding="UTF-8"?>
<!--
  Openbox is here only to give Firefox focus and a maximised window. Everything
  unspecified falls back to openbox's built-in defaults.

  Without this, openbox decorates the window with a title bar that costs ~61px
  of a phone-sized screen and duplicates the title Firefox already shows.
-->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <applications>
    <application class="*">
      <decor>no</decor>
      <maximized>yes</maximized>
      <position force="yes">
        <x>0</x>
        <y>0</y>
      </position>
    </application>
  </applications>
</openbox_config>
