# Firefox on a headless X server, exposed over VNC.
#
# Xvnc is both the X server and the VNC server in one process, which is what
# makes this image short: no display manager, no session manager, no PAM, and
# nothing that needs to be root.
FROM docker.io/library/debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install --no-install-recommends --yes \
        ca-certificates \
        dbus-x11 \
        firefox-esr \
        fonts-dejavu-core \
        fonts-noto-color-emoji \
        openbox \
        procps \
        tigervnc-standalone-server \
        x11-utils \
        x11-xserver-utils \
        xauth \
    && rm -rf /var/lib/apt/lists/*

# Nothing here needs privileges, so nothing here gets them.
RUN useradd --create-home --shell /bin/bash kiosk

# Xvnc runs unprivileged and so cannot create this itself:
#   _XSERVTransmkdir: ERROR: euid != 0, directory /tmp/.X11-unix will not be created
RUN mkdir -p /tmp/.X11-unix && chmod 1777 /tmp/.X11-unix

COPY entrypoint.sh session.sh /usr/local/bin/
COPY firefox-user.js /opt/firefox-user.js
RUN chmod +x /usr/local/bin/entrypoint.sh /usr/local/bin/session.sh

USER kiosk
WORKDIR /home/kiosk

# Physical pixels, like a phone panel. Divided by DEVICE_PIXEL_RATIO this is a
# 450x1000 CSS viewport -- see firefox-user.js for why 2.4 and not something
# rounder.
ENV LANG=C.UTF-8 \
    DISPLAY=:0 \
    SCREEN_WIDTH=1080 \
    SCREEN_HEIGHT=2400 \
    SCREEN_DPI=420 \
    DEVICE_PIXEL_RATIO=2.4 \
    KIOSK_URL=http://localhost:8080/kiosk \
    USER_AGENT="Mozilla/5.0 (Android 14; Mobile; rv:128.0) Gecko/128.0 Firefox/128.0"

EXPOSE 5900

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
