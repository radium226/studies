# A normal Firefox on a Wayland compositor, published over VNC.
#
# The X11 version of this image needed three processes and an X server: xrdp on
# 3389, xrdp-sesman authenticating through PAM, and an Xorg with the xorgxrdp
# driver started per session. All of it existed to reach one feature -- the RDP
# Display Control channel, which is what makes the session reflow when the phone
# rotates instead of letterboxing.
#
# sway is that whole stack in one unprivileged process: a headless wlroots
# compositor is the display and the window manager, wayvnc publishes it, and
# guacd 1.6 asks for a new size over RFB when the phone turns. See the README
# for why this is VNC again after the study deliberately left it, and for the
# weston/RDP attempt that came first and does not work.
FROM docker.io/library/debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive

# wayland-utils is for `mise run rdp`: wayland-info is the only way left to ask
# what shape the session currently is, now that there is no xdpyinfo.
RUN apt-get update \
    && apt-get install --no-install-recommends --yes \
        ca-certificates \
        dbus-daemon \
        firefox-esr \
        fonts-dejavu-core \
        fonts-noto-color-emoji \
        procps \
        sway \
        wayland-utils \
        wayvnc \
        xkb-data \
    && rm -rf /var/lib/apt/lists/*

# The session user. Nothing authenticates it: wayvnc serves the desktop to
# whoever connects, so there is no password, no PAM and no /etc/shadow in the
# picture. It exists only to own XDG_RUNTIME_DIR and to not be root.
RUN useradd --create-home --uid 1000 --shell /bin/bash firefox \
    && mkdir -p /run/user/1000 /control \
    && chown firefox:firefox /run/user/1000 /control \
    && chmod 700 /run/user/1000

# /control is a volume shared with the tunnel container, and sway's IPC socket
# is what crosses it. The tunnel is what reshapes this session -- it is the only
# process that knows when nothing is connected, which is the only moment a VNC
# desktop can change size. See app/src/guac_tunnel/session.py.
#
# The path is pinned rather than left to sway, which would otherwise put the
# socket at a name containing its own pid.

COPY entrypoint.sh session.sh /usr/local/bin/
COPY sway-config /etc/sway/config
COPY firefox-user.js /opt/firefox-user.js
RUN chmod +x /usr/local/bin/entrypoint.sh /usr/local/bin/session.sh

USER firefox
WORKDIR /home/firefox

# SCREEN_WIDTH/SCREEN_HEIGHT are a fallback, not a configuration: they are the
# output sway starts with, and every size after the first connection comes from
# the client instead. DEVICE_PIXEL_RATIO is what divides that down to a CSS
# viewport -- see firefox-user.js for why 2.4 and not something rounder.
ENV LANG=C.UTF-8 \
    XDG_RUNTIME_DIR=/run/user/1000 \
    SWAYSOCK=/control/sway.sock \
    WAYVNC_SOCKET=/control/wayvnc.sock \
    WAYLAND_DISPLAY=wayland-1 \
    MOZ_ENABLE_WAYLAND=1 \
    GDK_BACKEND=wayland \
    SCREEN_WIDTH=1080 \
    SCREEN_HEIGHT=2400 \
    DEVICE_PIXEL_RATIO=2.4 \
    KEYBOARD_LAYOUT=fr \
    START_URL=http://localhost:8080/diagnostics \
    USER_AGENT="Mozilla/5.0 (Android 14; Mobile; rv:128.0) Gecko/128.0 Firefox/128.0"

EXPOSE 5900

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
