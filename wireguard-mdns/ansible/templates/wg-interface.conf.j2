[Interface]
Address = {{ local_address }}
PrivateKey = {{ wg_private_key }}
{% if listen_port is defined and listen_port %}
ListenPort = {{ listen_port }}
{% endif %}
# WireGuard interfaces don't carry the MULTICAST link flag by default, so
# avahi (and the unicast mDNS repeater on the hub) silently treat them as
# unusable -- no relevant-interface log line, no error either -- unless
# it's turned on explicitly.
PostUp = ip link set dev %i multicast on

{% for peer in peers %}
[Peer]
PublicKey = {{ peer.pubkey }}
AllowedIPs = {{ peer.allowed_ips }}
{% if peer.endpoint is defined %}
Endpoint = {{ peer.endpoint }}
{% endif %}
{% if peer.persistent_keepalive is defined %}
PersistentKeepalive = {{ peer.persistent_keepalive }}
{% endif %}

{% endfor %}
