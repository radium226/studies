[server]
use-ipv4=yes
use-ipv6=no
allow-interfaces={{ avahi_allow_interfaces }}
ratelimit-interval-usec=1000000
ratelimit-burst=1000

[wide-area]
enable-wide-area=yes

[publish]
publish-hinfo=no
publish-workstation=no

[reflector]
enable-reflector={{ 'yes' if avahi_enable_reflector else 'no' }}

[rlimits]
rlimit-nproc=3
