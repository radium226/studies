#!/bin/bash
# Proof-of-concept: registers this host's own WireGuard address with the
# hub's DNS server via a real RFC 2136 dynamic update (nsupdate) -- run
# from wg0's PostUp, so it fires every time the tunnel comes up,
# including on every reboot, not just during provisioning.
#
# Retries rather than depending on strict startup ordering: a systemd
# drop-in makes named wait for the server's own wg0, but there's no such
# guarantee that named has finished starting by the time a *spoke's*
# wg0 comes up (e.g. simultaneous boot).
#
# Plain file, not a template: HOSTNAME, IPV4, IPV6 and DNS_SERVER are all
# derived at runtime from wg0 itself, so the same script deploys unchanged
# to every peer.
set -u

HOSTNAME="$(hostname)"
IPV4="$(ip -4 -o addr show dev wg0 | awk '{print $4}' | cut -d/ -f1)"
IPV6="$(ip -6 -o addr show dev wg0 scope global | awk '{print $4}' | cut -d/ -f1)"
DNS_SERVER="$(echo "$IPV4" | awk -F. '{print $1"."$2"."$3".1"}')"
REVERSE_NAME="$(echo "$IPV4" | awk -F. '{print $4"."$3"."$2"."$1}').in-addr.arpa."

register() {
    nsupdate <<EOF
server $DNS_SERVER
zone wg.
update delete $HOSTNAME.wg A
update delete $HOSTNAME.wg AAAA
update add $HOSTNAME.wg 300 A $IPV4
update add $HOSTNAME.wg 300 AAAA $IPV6
send
zone 0.0.10.in-addr.arpa.
update delete $REVERSE_NAME PTR
update add $REVERSE_NAME 300 PTR $HOSTNAME.wg.
send
EOF
}

for attempt in $(seq 1 10); do
    if register; then
        logger -t wg-dns-register "registered $HOSTNAME.wg -> $IPV4 / $IPV6"
        exit 0
    fi
    sleep 2
done

logger -t wg-dns-register "FAILED to register $HOSTNAME.wg after 10 attempts"
exit 1
